# ===============================
# SERVER CONFIG
# ===============================
PORT=8000
NODE_ENV=development

# ===============================
# DATABASE
# ===============================
MONGODB_URI=

# ===============================
# FRONTEND
# ===============================
# URL where frontend is running (used for redirects after login / OAuth)
FRONTEND_URL=

# ===============================
# JWT CONFIG
# ===============================
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=

REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=

# ===============================
# EMAIL (BREVO)
# ===============================
BREVO_API_KEY=
# EMAIL_FROM=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# ===============================
# EMAIL VERIFICATION
# ===============================
EMAIL_VERIFICATION_TOKEN_EXPIRY=
PASSWORD_RESET_TOKEN_EXPIRY=

# ===============================
# GOOGLE OAUTH
# ===============================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# No callback URL variable: it's built from the server's own host (see Backend/src/config/passport.js).
# Google Cloud Console must list both http://localhost:8000/api/v1/auth/google/callback
# and https://video-treasure-backend.onrender.com/api/v1/auth/google/callback as redirect URIs.

# ===============================
# YOUTUBE
# ===============================
YOUTUBE_API_KEY=
# stub: canned results, no YouTube quota spent (use it for local dev). live, or unset: real API calls.
# Render leaves it unset. Stub videos are cached in the database MONGODB_URI points to, so use a
# separate database locally; their ids start with "stub".
YOUTUBE_MODE=stub
# YouTube's daily quota per Google Cloud project, reset at midnight Pacific time. Raise these only
# after a quota extension is granted. Search calls are split 70% users, 15% each crawler.
YOUTUBE_SEARCH_CALLS_PER_DAY=100
YOUTUBE_GENERAL_UNITS_PER_DAY=10000
# Optional: limit the niche crawler's YouTube searches to videos viewable in this country (e.g. IN).
# Unset: no country limit.
NICHE_REGION_CODE=
# Optional: the key for hashing visitors' IPs in the search log (trend detection).
# Unset: ACCESS_TOKEN_SECRET is used. Changing it only affects new log entries.
VISITOR_HASH_SECRET=

# ===============================
# PROXY
# ===============================
# How many proxies sit in front of the app (Render: check the "[proxy]" log lines after a deploy).
# It is 1 + the number of X-Forwarded-For entries to the right of the visitor's own IP.
TRUST_PROXY_HOPS=1

# ===============================
# PROCESSES (only for running several API instances, e.g. deploy/docker-compose.yml)
# ===============================
# false: this process only serves the API; run `npm run worker` for the jobs and startup migrations.
# Unset (Render): one process does everything.
RUN_JOBS_IN_API=
# mongo: the flood limit's counts are shared by all API instances. Unset: in this process's memory.
RATE_LIMIT_STORE=

# ===============================
# CORS`
# ===============================
CORS_ORIGIN=

DAILYMOTION_API_KEY=
DAILYMOTION_CLIENT_SECRET=